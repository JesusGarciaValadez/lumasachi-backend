APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
APP_MAINTEINER_EMAIL=null

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Use a PostgreSQL provisioning role separate from the application's DB user.
# These values are required outside testing before tenant database provisioning is enabled.
# TENANCY_DB_PROVISIONER_HOST=127.0.0.1
# TENANCY_DB_PROVISIONER_PORT=5432
# TENANCY_DB_PROVISIONER_DATABASE=postgres
# TENANCY_DB_PROVISIONER_USERNAME=tenant_provisioner
# TENANCY_DB_PROVISIONER_PASSWORD=
# TENANCY_TENANT_TEMPLATE_CONNECTION=pgsql
# TENANCY_CENTRAL_CONNECTION=pgsql
# Set parent domains for {company}.example.com and exact central hosts independently.
# TENANCY_CENTRAL_DOMAINS=example.com
# TENANCY_CENTRAL_HOSTS=app.example.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Orders cache TTLs
ORDERS_INDEX_TTL=60
ORDERS_SHOW_TTL=300


# Order histories cache TTLs
ORDER_HISTORIES_INDEX_TTL=120
ORDER_HISTORIES_SHOW_TTL=300

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SAIL_XDEBUG_MODE=develop,debug,coverage

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

TELESCOPE_ENABLED=false

SANCTUM_TOKEN_PREFIX=null

NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1

# Laravel Pennant
PENNANT_STORE=database

# Feature: Motor Items (Pennant class: App\Features\MotorItems)
FEATURE_MOTOR_ITEMS_DISABLED=false
FEATURE_MOTOR_ITEMS_ROLLOUT_DATE=
